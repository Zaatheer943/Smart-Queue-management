rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isCustomer() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'customer';
    }
    
    function isStaff() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'staff';
    }
    
    function isActiveUser() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
    }
    
    // Users collection
    match /users/{userId} {
      // Users can read their own data
      allow read: if isOwner(userId) || isAdmin();
      
      // Authenticated users can read any user data (needed for fetching user details when joining queue)
      allow read: if isAuthenticated();
      
      // Users can create their own account (during registration)
      allow create: if isAuthenticated() && request.auth.uid == userId;
      
      // Users can update their own data (except role)
      allow update: if isOwner(userId) && 
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
      
      // Only admins can delete users
      allow delete: if isAdmin();
    }
    
    // Organisations collection
    match /organisations/{orgId} {
      // Authenticated users can read organisations (needed for browsing and queue operations)
      allow read: if isAuthenticated();
      
      // Only admins can create/update/delete organisations
      allow create, update, delete: if isAdmin();
      
      // Services subcollection
      match /services/{serviceId} {
        // Anyone can read active services
        allow read: if resource.data.active == true;
        
        // Only admins can create/update/delete services
        allow create, update, delete: if isAdmin();
      }
      
      // Queues subcollection (direct under organisation)
      match /queues/{queueId} {
        // Authenticated users can read queues (needed for finding active tokens)
        allow read: if isAuthenticated();
        
        // Authenticated users can create queues (when joining queue)
        allow create: if isAuthenticated();
        
        // Admins and staff can update queues (for queue operations)
        allow update: if isAdmin() || isStaff();
        
        // Only admins can delete queues
        allow delete: if isAdmin();
        
        // Tokens subcollection
        match /tokens/{tokenId} {
          // Authenticated users can read/list tokens (needed for checking active tokens across all queues)
          allow read, list: if isAuthenticated();
          
          // Authenticated users can create tokens (join queue) - removed userId check for now to allow creation
          allow create: if isAuthenticated();
          
          // Users can update their own token (cancel)
          allow update: if isOwner(resource.data.userId) && 
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt']) &&
                         request.resource.data.status == 'cancelled';
          
          // Admins and staff can update tokens (call, serve, complete, skip, etc.)
          allow update: if isAdmin() || isStaff();
          
          // Only admins can delete tokens
          allow delete: if isAdmin();
        }
      }
    }
    
    // Analytics collection (admin only)
    match /analytics/{analyticsId} {
      allow read, write: if isAdmin();
    }
  }
}
